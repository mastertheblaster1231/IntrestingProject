{
  "framework": "vite",
  "buildCommand": "cd MainProjectFiles && npm run build",
  "outputDirectory": "MainProjectFiles/dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/ocean", "destination": "/ocean.html" },
    { "source": "/erddap-proxy/(.*)", "destination": "https://erddap.ifremer.fr/$1" }
  ]
}
