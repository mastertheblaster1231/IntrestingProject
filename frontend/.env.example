# Frontend — Vite (frontend/.env) — copy to frontend/.env
# Backend URL for API calls
# - Local dev: http://localhost:8000 (or http://127.0.0.1:8000) — direct to Express backend
# - Production: set to your deployed backend URL, e.g. https://your-backend.onrender.com
# - Or leave empty to use same-origin /api (Vite proxy in dev, Vercel rewrite in prod)
VITE_BACKEND_URL=http://localhost:8000
VITE_ERDDAP_IFREMER_BASE=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats.json
VITE_ERDDAP_PROXY_PATH=/erddap-proxy
VITE_ERDDAP_INCOIS_BASE=https://erddap.incois.gov.in/erddap
VITE_INCOIS_WFS_URL=https://incois.gov.in/geoserver/Insitu_TideGauges_Tsunami/ows
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
